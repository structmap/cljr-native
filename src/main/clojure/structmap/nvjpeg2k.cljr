;(comment

(def h
  (let [m   (new IntPtr)
        gch (GCHandle/Alloc m GCHandleType/Pinned)]
    (nvjpeg2kCreate NVJPEG2K_BACKEND_DEFAULT IntPtr/Zero IntPtr/Zero (.AddrOfPinnedObject gch))
    (.Free gch)
    m))

(def params
  (let [m   (new IntPtr)
        gch (GCHandle/Alloc m GCHandleType/Pinned)]
    (nvjpeg2kDecodeParamsCreate (.AddrOfPinnedObject gch))
    (.Free gch)
    m))

(def decode_state
  (let [m   (new IntPtr)
        gch (GCHandle/Alloc m GCHandleType/Pinned)]
    (nvjpeg2kDecodeStateCreate h (.AddrOfPinnedObject gch))
    (.Free gch)
    m))

(def decode_params
  (let [m   (new IntPtr)
        gch (GCHandle/Alloc m GCHandleType/Pinned)]
    (nvjpeg2kDecodeParamsCreate (.AddrOfPinnedObject gch))
    (.Free gch)
    m))

(def s
  (let [m   (new IntPtr)
        gch (GCHandle/Alloc m GCHandleType/Pinned)]
    (nvjpeg2kStreamCreate (.AddrOfPinnedObject gch))
    (.Free gch)
    m))


